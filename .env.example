# SQLite (persistent container volume: /app/data/crm.db)
DB_PATH="./data/crm.db"
# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=""
# Canonical CRM origin, no path/query; use HTTPS in production.
CRM_PUBLIC_URL="http://localhost:3000"
# Storefront SERVER credential: openssl rand -hex 32 (>=32 characters).
# Blank disables /api/storefront/v1/*. Never NEXT_PUBLIC_* or browser code.
STOREFRONT_API_KEY=""
# Additional exact browser origins for staging/admin mutations (comma-separated).
# Set explicitly for the CRM deployment's origin.
SECURITY_ALLOWED_ORIGINS="http://localhost:3000"
# Optional IP budgets: set ONLY after checking that the trusted proxy overwrites
# x-real-ip or appends the nearest client to x-forwarded-for, with no direct port access.
# Leave empty to use shared global/account/phone budgets without trusting caller IPs.
SECURITY_TRUSTED_IP_HEADER=""
# Dedicated live catalog skill credential (at least 32 characters; runtime only).
# Generate with: openssl rand -hex 32. Unset disables /api/catalog-agent/*.
CATALOG_AGENT_KEY=""
# Ozon Express (API key goes in the URL path — never commit, never log)
OZON_CLIENT_ID=""
OZON_API_KEY=""
OZON_BASE_URL="https://api.ozonexpress.ma"
OZON_USE_CUSTOM_TRACKING="0"
OZON_SUBMIT_INTERVAL_SEC="15"
OZON_POLL_INTERVAL_MIN="30"
OZON_TRACK_BATCH="25"
# Image uploads (default: <DB_PATH dir>/uploads; Compose fixes /app/data/uploads)
UPLOAD_DIR=""
# Keep mock until owner-authorized live onboarding. ONLY exact "mock" selects
# mock in runtime code; unset/other values select Ozon outside Compose defaults.
DELIVERY_PROVIDER="mock"
# Optional server-side Meta integration; no browser Pixel is mounted.
FACEBOOK_PIXEL_ID=""
FACEBOOK_ACCESS_TOKEN=""
FACEBOOK_TEST_EVENT_CODE=""
FACEBOOK_API_VERSION="v22.0"
# Admin-only, read-only CRM assistant (server-side runtime variables)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="qwen/qwen3.7-flash"
